<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="Yourself Copilot · 图片管理" Width="860" Height="920" MinWidth="720" MinHeight="760" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
 Background="#FAF9F6" Foreground="#29312C" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="14" UseLayoutRounding="True">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <SolidColorBrush x:Key="Accent" Color="#507F60"/>
  <Style TargetType="Button"><Setter Property="Background" Value="#FEFDFC"/><Setter Property="Foreground" Value="#343C36"/><Setter Property="BorderBrush" Value="#DCDDD7"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="17,10"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Body" Property="Opacity" Value="0.6"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="#2D6341"/><Setter TargetName="Body" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,6"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="Padding" Value="0,2"/><Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#507F60"/></Trigger></Style.Triggers></Style>
  <Style TargetType="CheckBox"><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,5"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Height="32"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><ContentPresenter VerticalAlignment="Center"/><Border x:Name="Track" Grid.Column="1" Width="42" Height="23" CornerRadius="12" Background="#CDD0C9" VerticalAlignment="Center"><Ellipse x:Name="Thumb" Width="17" Height="17" Fill="White" HorizontalAlignment="Left" Margin="3,0"/></Border></Grid>
    <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#234E32"/><Setter TargetName="Track" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Track" Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Slider"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Height="24" Background="Transparent" Margin="8,0"><Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" Orientation="Horizontal">
    <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" Background="#507F60" CornerRadius="2"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
    <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" Background="#D6DAD2" CornerRadius="2"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
    <Track.Thumb><Thumb Width="19" Height="19"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="#FDFDFC" Stroke="#507F60" StrokeThickness="1.5"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
   </Track></Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Margin" Value="0,2,10,4"/><Setter Property="Padding" Value="4"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" BorderThickness="2" BorderBrush="Transparent" Background="#FFFDFC" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#507F60"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#EAF0E8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Border Background="#FAF9F6" BorderBrush="#DDDFD8" BorderThickness="1" CornerRadius="12">
  <Grid><Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="62"/><RowDefinition Height="*"/><RowDefinition Height="30"/><RowDefinition Height="82"/><RowDefinition Height="100"/><RowDefinition Height="Auto"/><RowDefinition Height="48"/></Grid.RowDefinitions>
   <Border Grid.Row="0" BorderBrush="#E5E5DE" BorderThickness="0,0,0,1" Margin="24,0"><DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button x:Name="MinimizeButton" Width="40" Padding="0" Style="{StaticResource Quiet}" ToolTip="最小化" AutomationProperties.Name="最小化"><TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="12"/></Button><Button x:Name="MaximizeButton" Width="40" Padding="0" Style="{StaticResource Quiet}" ToolTip="最大化或还原" AutomationProperties.Name="最大化或还原"><TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="12"/></Button><Button x:Name="CloseButton" Width="40" Padding="0" Style="{StaticResource Quiet}" ToolTip="收起窗口，桌面图片继续显示" AutomationProperties.Name="收起窗口"><TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="12"/></Button></StackPanel>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="25" Height="25" Background="{StaticResource Accent}" CornerRadius="5"><TextBlock Text="y" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="19" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,-3,0,0"/></Border><TextBlock Text="Yourself Copilot" FontFamily="Segoe UI" FontSize="19" FontWeight="SemiBold" Margin="9,0,10,0" VerticalAlignment="Center"/><TextBlock Text="桌面图片" FontSize="12" Foreground="#7B817A" VerticalAlignment="Center"/></StackPanel>
   </DockPanel></Border>
   <Grid Grid.Row="1" Margin="24,12,24,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button x:Name="AddButton" Style="{StaticResource Primary}" MinWidth="154" ToolTip="添加图片 · Ctrl+O"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE109;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,9,0" VerticalAlignment="Center"/><TextBlock Text="添加图片"/></StackPanel></Button>
    <Button x:Name="PasteButton" Grid.Column="1" MinWidth="142" Margin="12,0,0,0" ToolTip="粘贴剪贴板图片 · Ctrl+V"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE77F;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,9,0" VerticalAlignment="Center"/><TextBlock Text="粘贴图片"/></StackPanel></Button>
    <Button x:Name="UndoButton" Grid.Column="2" Content="撤销移除" Style="{StaticResource Quiet}" HorizontalAlignment="Right" Margin="8,0" Visibility="Collapsed"/>
    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Accent}" FontSize="13" VerticalAlignment="Center" Margin="12,0,6,0"/><TextBlock x:Name="SaveStatus" Text="已自动保存" FontSize="12" Foreground="#70796F" VerticalAlignment="Center"/></StackPanel>
   </Grid>
   <Border x:Name="DropStage" Grid.Row="2" Margin="24,4,24,12" Background="#F0EFEB" BorderBrush="#E5E3DD" BorderThickness="1" CornerRadius="8" AllowDrop="True"><Grid Margin="14"><Image x:Name="Preview" Stretch="Uniform" AutomationProperties.Name="选中图片的预览"/><StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"><TextBlock Text="把想看的，留在桌面。" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="添加图片，或直接拖到这里" Foreground="#7B8378" Margin="0,14,0,0" HorizontalAlignment="Center"/><Button x:Name="EmptyAddButton" Content="添加第一张图片" Style="{StaticResource Primary}" Margin="0,24,0,0"/></StackPanel></Grid></Border>
   <Grid Grid.Row="3" Margin="24,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="NameInput" FontSize="15" FontWeight="SemiBold" MaxLength="64" VerticalAlignment="Center" MinWidth="120" MaxWidth="460" HorizontalAlignment="Left" AutomationProperties.Name="图片名称" ToolTip="点击修改名称，按 Enter 保存"/><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="ImageMeta" Foreground="#858A80" FontSize="11"/><TextBlock x:Name="LibraryCount" Foreground="#858A80" FontSize="11" Margin="12,0,0,0"/></StackPanel></Grid>
   <ListBox x:Name="LibraryList" Grid.Row="4" Margin="24,0,24,4" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="桌面图片列表"><ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Grid Width="94" Height="53" ToolTip="{Binding Subtitle}"><Image Source="{Binding Thumbnail}" Stretch="Uniform"/><TextBlock Text="{Binding Title}" AutomationProperties.Name="图片名称" Visibility="Collapsed"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
   <Grid x:Name="Inspector" Grid.Row="5" Margin="28,0,28,6"><Grid.ColumnDefinitions><ColumnDefinition Width="0.43*"/><ColumnDefinition Width="34"/><ColumnDefinition Width="0.57*"/></Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0" Margin="0,0,18,0"><CheckBox x:Name="VisibleSwitch" AutomationProperties.Name="显示在桌面"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" FontSize="17" VerticalAlignment="Center"/><TextBlock Text="显示在桌面"/></StackPanel></CheckBox><CheckBox x:Name="LockSwitch" AutomationProperties.Name="锁定位置"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE718;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" FontSize="17" VerticalAlignment="Center"/><TextBlock Text="锁定位置"/></StackPanel></CheckBox></StackPanel>
    <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="40"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="缩放" Margin="0,0,5,0"/><TextBlock x:Name="ScaleValue" Text="100%"/></StackPanel><Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="27"/><RowDefinition Height="15"/></Grid.RowDefinitions><Slider x:Name="ScaleSlider" Minimum="10" Maximum="200" Value="100" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" AutomationProperties.Name="缩放大小"/><DockPanel Grid.Row="1" Margin="8,0"><TextBlock x:Name="ScaleMin" Text="10%" FontSize="10" Foreground="#8A9087"/><TextBlock Text="200%" FontSize="10" Foreground="#8A9087" HorizontalAlignment="Right"/></DockPanel></Grid></Grid>
    <StackPanel Grid.Row="1" Orientation="Horizontal"><Button x:Name="RepositionButton" Style="{StaticResource Quiet}" Foreground="{StaticResource Accent}" Padding="0,6,16,6"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="17" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="恢复位置"/></StackPanel></Button><Button x:Name="ActualSizeButton" Content="原图大小" Style="{StaticResource Quiet}" Padding="8,6" Foreground="#737D70"/></StackPanel></Grid>
   </Grid>
   <Expander Grid.Row="6" Header="更多操作" Foreground="#788173" FontSize="12" Margin="28,0,28,8"><StackPanel Orientation="Horizontal" Margin="0,7,0,0"><Button x:Name="ReplaceButton" Content="更换这张图片…" Style="{StaticResource Quiet}"/><Button x:Name="RemoveButton" Content="从列表移除" Style="{StaticResource Quiet}" Foreground="#8B6A63" ToolTip="可以撤销，原图片保留"/></StackPanel></Expander>
   <Border Grid.Row="7" BorderBrush="#E0E2DA" BorderThickness="0,1,0,0" Margin="24,0"><DockPanel LastChildFill="True" VerticalAlignment="Center"><Button x:Name="WorkboardButton" DockPanel.Dock="Left" Content="想法与任务" Style="{StaticResource Primary}" FontSize="12" Padding="12,5" Margin="0,0,14,0"/><Button x:Name="HelpButton" DockPanel.Dock="Right" Content="帮助" Style="{StaticResource Quiet}" Foreground="#80887A" FontSize="12" Padding="8,3"/><TextBlock Text="拖入图片，或按 Ctrl+V 粘贴" Foreground="#858B80" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel></Border>
   <Border x:Name="MessageBar" Grid.Row="2" Grid.RowSpan="5" VerticalAlignment="Bottom" Margin="28,0,28,6" Background="#EDF3E9" BorderBrush="#CFDCC9" BorderThickness="1" Padding="14,11" CornerRadius="8" Visibility="Collapsed"><DockPanel><Button x:Name="DismissMessageButton" Content="关闭提示" DockPanel.Dock="Right" Style="{StaticResource Quiet}" Padding="8,0" Margin="12,0,0,0"/><TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="#46623D" VerticalAlignment="Center"/></DockPanel></Border>
  </Grid>
 </Border>
</Window>
