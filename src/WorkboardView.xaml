<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent" TextElement.Foreground="#344438" TextElement.FontFamily="Microsoft YaHei UI, Segoe UI" TextElement.FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Grid.Resources>
  <Style TargetType="Button">
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#58745E"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="9,5"/><Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Body" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="#64806B" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Background" Value="#E8ECE2"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderThickness" Value="1"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#344438"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0,4"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="SelectionBrush" Value="#C3D2BE"/><Setter Property="CaretBrush" Value="#58745E"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#64806B"/><Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Padding" Value="0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border x:Name="Box" Width="16" Height="16" CornerRadius="3" BorderBrush="#97A58E" BorderThickness="1" Background="Transparent" VerticalAlignment="Center"><Path x:Name="Tick" Data="M 2,7 L 5.5,10.5 L 12,3.5" Stroke="White" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/></Border><ContentPresenter x:Name="Label" Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/></Grid><ControlTemplate.Triggers><Trigger Property="HasContent" Value="False"><Setter TargetName="Label" Property="Visibility" Value="Collapsed"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#64806B"/><Setter TargetName="Box" Property="BorderBrush" Value="#64806B"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#344438"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#344438"/><Setter TargetName="Box" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Grid.Resources>
 <Border BorderBrush="#E2E3D9" BorderThickness="1" CornerRadius="14" Background="#FAF8F3">
  <Grid Margin="18,5,18,0">
   <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="49"/><RowDefinition Height="*"/><RowDefinition Height="40"/><RowDefinition Height="24"/></Grid.RowDefinitions>
   <Grid x:Name="CardHeader" Background="Transparent" Cursor="SizeAll">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="27"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False"><ContentControl x:Name="CompanionBrand" Width="23" Height="23" Focusable="False"/><TextBlock Text="Yourself Copilot" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
    <Button x:Name="OpenWorkbenchButton" Grid.Column="1" Content="工作台" FontSize="11" Padding="5,4" VerticalAlignment="Center" AutomationProperties.Name="打开工作台"/>
    <Button x:Name="CardMenuButton" Grid.Column="2" FontSize="18" Padding="4" VerticalAlignment="Center" AutomationProperties.Name="卡片更多操作" ToolTip="更多操作"/>
   </Grid>
   <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="17"/><RowDefinition Height="32"/></Grid.RowDefinitions>
    <DockPanel><TextBlock x:Name="TaskCount" DockPanel.Dock="Right" Foreground="#7C8678" FontSize="10"/><TextBlock x:Name="ScopeDate" FontSize="10" Foreground="#7C8678"/></DockPanel>
    <UniformGrid Grid.Row="1" Columns="4" HorizontalAlignment="Stretch"><Button x:Name="Scope_today" Content="今天" Padding="6,4" FontSize="12" Margin="0,0,5,0"/><Button x:Name="Scope_tomorrow" Content="明天" Padding="6,4" FontSize="12" Margin="0,0,5,0"/><Button x:Name="Scope_later" Content="以后" Padding="6,4" FontSize="12" Margin="0,0,5,0"/><Button x:Name="Scope_all" Content="全部" Padding="6,4" FontSize="12"/></UniformGrid>
   </Grid>
   <Grid x:Name="MemoSplitPanel" Grid.Row="2">
    <Grid.RowDefinitions><RowDefinition Height="0.35*"/><RowDefinition Height="28"/><RowDefinition Height="0.65*"/></Grid.RowDefinitions>
   <ScrollViewer x:Name="TaskScroll" Margin="0,5,0,6" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="TaskContents">
    <TextBlock x:Name="TasksPlaceholder" Text="还没有任务，从一件小事开始。" Foreground="#7C8678" FontSize="12" Margin="0,8,0,10" TextWrapping="Wrap" IsHitTestVisible="False"/>
    <StackPanel x:Name="TaskRows"/>
    <Expander x:Name="CompletedGroup" Header="已完成" Foreground="#92978C" FontSize="11" Margin="0,8,0,4" Visibility="Collapsed" AutomationProperties.Name="已完成任务，展开或收起"><StackPanel x:Name="CompletedRows" Margin="0,5,0,0"/></Expander>
   </StackPanel></ScrollViewer>
   <Border Grid.Row="1" Height="1" VerticalAlignment="Center" Background="#DDE2D7" IsHitTestVisible="False"/>
   <GridSplitter x:Name="MemoDivider" Grid.Row="1"/>
   <Border x:Name="MemoRegion" Grid.Row="2" Background="#FDFCF9" BorderBrush="#E2E3D9" BorderThickness="1" CornerRadius="9" Margin="0,0,0,5"><Grid Margin="12,6,10,6">
    <Grid.RowDefinitions><RowDefinition Height="23"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><Button x:Name="ExpandMemoButton" DockPanel.Dock="Right" Width="23" Height="23" Padding="4" ToolTip="在工作台展开随手记" AutomationProperties.Name="展开随手记"/><ContentControl x:Name="MemoPaperActionsHost"/></DockPanel>
    <Grid Grid.Row="1"><TextBox x:Name="IdeasInput" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" IsReadOnly="True" AutomationProperties.Name="我的想法" ToolTip="点击这里写下想法；内容自动保存在本机"/><TextBlock x:Name="IdeasPlaceholder" Text="先记下来，慢慢整理…" Foreground="#949E8D" Margin="0,4,0,0" IsHitTestVisible="False"/></Grid>
   </Grid></Border>
   </Grid>
   <Border Grid.Row="3" Background="#FEFDF9" BorderBrush="#DFE2D7" BorderThickness="1" CornerRadius="8" Margin="0,3,0,0"><Grid Margin="9,3,3,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="29"/></Grid.ColumnDefinitions><TextBox x:Name="NewTaskInput" IsReadOnly="True" MaxLength="240" AutomationProperties.Name="新任务" ToolTip="输入任务后按 Enter 添加"/><TextBlock x:Name="TaskPlaceholder" Text="添加一个任务…" Foreground="#949E8D" VerticalAlignment="Center" IsHitTestVisible="False"/><Button x:Name="AddTaskButton" Grid.Column="1" Background="#58745E" Foreground="White" Padding="4" AutomationProperties.Name="添加任务" ToolTip="添加任务"/></Grid></Border>
   <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="CardSaveStatus" Text="自动保存 · 仅本机" ToolTip="内容停止输入后自动保存；浏览和调整窗口不提示内容保存。" Foreground="#7C8678" FontSize="10" VerticalAlignment="Center"/><Button x:Name="UndoTaskButton" Grid.Column="1" Content="撤销移除" FontSize="10" Padding="4,1" Visibility="Collapsed"/></Grid>
  </Grid>
 </Border>
</Grid>
